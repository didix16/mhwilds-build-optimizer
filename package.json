{
  "name": "mhwilds-build-optimizer",
  "version": "0.1.0",
  "private": true,
  "engines": {"node": ">=22.12.0"},
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "data:fetch": "node scripts/fetch-sources.mjs",
    "data:build": "node scripts/normalize-data.mjs",
    "data:icons": "node scripts/fetch-icons.mjs",
    "combat:fetch": "node scripts/fetch-combat.mjs",
    "combat:build": "node scripts/build-combat.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:data": "node scripts/check-data.mjs",
    "check:render": "node scripts/check-render.mjs",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "dependencies": {
    "immer": "^11.2.9",
    "primeicons": "^7.0.0",
    "primereact": "^10.9.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "@tailwindcss/vite": "^4.1.18",
    "@vitejs/plugin-react": "^5.1.2",
    "tailwindcss": "^4.1.18",
    "vite": "^7.3.1"
  }
}
